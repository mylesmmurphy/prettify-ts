{
  "name": "prettify-ts-monorepo",
  "publisher": "MylesMurphy",
  "license": "MIT",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "preinstall": "only-allow pnpm",
    "lint": "eslint .",
    "pretest": "tsc --project ./test/tsconfig.json && pnpm build:debug",
    "test": "vscode-test --config ./test/.vscode-test.js",
    "build": "pnpm -r run build",
    "build:debug": "pnpm --filter @prettify-ts/typescript-plugin build:debug && pnpm --filter prettify-ts run build",
    "package": "pnpm build && node ./scripts/package.js",
    "typecheck": "tsc --noEmit -p packages/typescript-plugin && tsc --noEmit -p packages/vscode-extension && tsc --noEmit -p test && tsc --noEmit -p test/unit",
    "test:unit": "node scripts/test-unit.js",
    "test:package": "pnpm build && tsc -p test && node scripts/test-package.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@types/vscode": "1.100.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "fs-extra": "^11.4.1",
    "only-allow": "^1.2.2",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24 <25"
  }
}
