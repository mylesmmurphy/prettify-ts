{
  "extends": "../../tsconfig.json",
  "include": [
    "./src/**/*"
  ],
  "compilerOptions": {
    // Type-checked only (esbuild bundles): resolves package exports and imports, as the TypeScript 7 types need.
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "lib": ["es2020"]
  }
}
